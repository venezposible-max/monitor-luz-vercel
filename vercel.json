{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://powerwatch.venezposible.workers.dev/api/$1"
    },
    {
      "source": "/devices",
      "destination": "https://powerwatch.venezposible.workers.dev/api/devices"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ],
  "headers": [
    {
      "source": "/api/p2p",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=10, stale-while-revalidate=5"
        }
      ]
    },
    {
      "source": "/((?!api/p2p).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-weekly-report",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/cron-daily-report",
      "schedule": "0 1 * * *"
    }
  ]
}
